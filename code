import javax.swing.*;
import javax.swing.table.DefaultTableModel;
import java.awt.*;
import java.io.*;
import java.nio.charset.StandardCharsets;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;

public class CanteenOrderManagementSystem extends JFrame {
    private static final String ORDER_FILE = "orders.csv";
    private final String[] items = {"Idli", "Dosa", "Poori", "Veg Meals", "Curd Rice", "Veg Sandwich", "Burger", "Samosa", "Tea", "Coffee", "Fresh Juice"};
    private final double[] prices = {30, 45, 40, 90, 50, 60, 80, 20, 12, 18, 35};
    private final JComboBox<String> itemBox = new JComboBox<>(items);
    private final JSpinner quantitySpinner = new JSpinner(new SpinnerNumberModel(1, 1, 100, 1));
    private final DefaultTableModel cartModel = new DefaultTableModel(new String[]{"Item", "Price (Rs.)", "Quantity", "Subtotal (Rs.)"}, 0) {
        @Override public boolean isCellEditable(int row, int column) { return false; }
    };
    private final JTable cartTable = new JTable(cartModel);
    private final JLabel totalLabel = new JLabel("Total: Rs. 0.00");
    private final JTextArea billArea = new JTextArea(12, 24);
    private final JLabel statusLabel = new JLabel("Ready to take an order.");

    public CanteenOrderManagementSystem() {
        super("Canteen Order Management System");
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setSize(1000, 650);
        setLocationRelativeTo(null);
        setLayout(new BorderLayout(10, 10));
        getContentPane().setBackground(new Color(245, 247, 250));

        JLabel heading = new JLabel("CANTEEN ORDER MANAGEMENT SYSTEM");
        heading.setFont(new Font("SansSerif", Font.BOLD, 22));
        heading.setForeground(Color.WHITE);
        heading.setBorder(BorderFactory.createEmptyBorder(18, 20, 18, 20));
        JPanel header = new JPanel(new BorderLayout());
        header.setBackground(new Color(35, 63, 94));
        header.add(heading, BorderLayout.CENTER);
        add(header, BorderLayout.NORTH);

        JPanel left = new JPanel();
        left.setPreferredSize(new Dimension(275, 0));
        left.setBackground(Color.WHITE);
        left.setBorder(BorderFactory.createCompoundBorder(BorderFactory.createEmptyBorder(8, 10, 8, 0), BorderFactory.createTitledBorder("Food Menu")));
        left.setLayout(new BoxLayout(left, BoxLayout.Y_AXIS));
        JLabel menuTitle = new JLabel("Select food item");
        menuTitle.setBorder(BorderFactory.createEmptyBorder(12, 10, 5, 5));
        left.add(menuTitle);
        itemBox.setMaximumSize(new Dimension(Integer.MAX_VALUE, 32));
        left.add(itemBox);

        JLabel priceLabel = new JLabel();
        priceLabel.setFont(new Font("SansSerif", Font.BOLD, 14));
        priceLabel.setForeground(new Color(35, 120, 75));
        priceLabel.setBorder(BorderFactory.createEmptyBorder(10, 10, 5, 5));
        left.add(priceLabel);
        itemBox.addActionListener(e -> updatePriceLabel(priceLabel));
        updatePriceLabel(priceLabel);

        JLabel quantityLabel = new JLabel("Quantity");
        quantityLabel.setBorder(BorderFactory.createEmptyBorder(12, 10, 5, 5));
        left.add(quantityLabel);
        quantitySpinner.setMaximumSize(new Dimension(Integer.MAX_VALUE, 32));
        left.add(quantitySpinner);

        JButton addButton = new JButton("Add to Cart");
        JButton removeButton = new JButton("Remove Selected");
        JButton clearButton = new JButton("Clear Order");
        JButton placeButton = new JButton("Place Order");
        styleButton(addButton, new Color(35, 139, 85));
        styleButton(removeButton, new Color(190, 55, 55));
        styleButton(clearButton, new Color(90, 98, 110));
        styleButton(placeButton, new Color(46, 100, 180));
        JPanel buttonPanel = new JPanel(new GridLayout(4, 1, 7, 7));
        buttonPanel.setBackground(Color.WHITE);
        buttonPanel.setBorder(BorderFactory.createEmptyBorder(20, 8, 10, 8));
        buttonPanel.add(addButton);
        buttonPanel.add(removeButton);
        buttonPanel.add(clearButton);
        buttonPanel.add(placeButton);
        left.add(buttonPanel);
        left.add(Box.createVerticalGlue());
        add(left, BorderLayout.WEST);

        cartTable.setRowHeight(27);
        cartTable.setFont(new Font("SansSerif", Font.PLAIN, 13));
        cartTable.getTableHeader().setFont(new Font("SansSerif", Font.BOLD, 12));
        cartTable.setSelectionMode(ListSelectionModel.SINGLE_SELECTION);
        JPanel center = new JPanel(new BorderLayout(8, 8));
        center.setBackground(new Color(245, 247, 250));
        center.setBorder(BorderFactory.createEmptyBorder(8, 0, 8, 0));
        JLabel cartHeading = new JLabel("Current Order / Cart");
        cartHeading.setFont(new Font("SansSerif", Font.BOLD, 16));
        cartHeading.setBorder(BorderFactory.createEmptyBorder(8, 8, 4, 4));
        center.add(cartHeading, BorderLayout.NORTH);
        center.add(new JScrollPane(cartTable), BorderLayout.CENTER);
        JPanel totalPanel = new JPanel(new BorderLayout());
        totalPanel.setBackground(Color.WHITE);
        totalPanel.setBorder(BorderFactory.createEmptyBorder(14, 12, 14, 12));
        totalLabel.setFont(new Font("SansSerif", Font.BOLD, 20));
        totalLabel.setForeground(new Color(35, 120, 75));
        totalPanel.add(totalLabel, BorderLayout.EAST);
        center.add(totalPanel, BorderLayout.SOUTH);
        add(center, BorderLayout.CENTER);

        JPanel right = new JPanel(new BorderLayout(5, 5));
        right.setPreferredSize(new Dimension(270, 0));
        right.setBackground(Color.WHITE);
        right.setBorder(BorderFactory.createCompoundBorder(BorderFactory.createEmptyBorder(8, 0, 8, 10), BorderFactory.createTitledBorder("Bill Preview")));
        billArea.setEditable(false);
        billArea.setFont(new Font("Monospaced", Font.PLAIN, 12));
        billArea.setText(" CANTEEN BILL\nAdd items to begin.");
        right.add(new JScrollPane(billArea), BorderLayout.CENTER);
        add(right, BorderLayout.EAST);

        JPanel footer = new JPanel(new BorderLayout());
        footer.setBackground(Color.WHITE);
        footer.setBorder(BorderFactory.createEmptyBorder(8, 14, 8, 14));
        footer.add(statusLabel, BorderLayout.WEST);
        footer.add(new JLabel("Prices in Indian Rupees (Rs.)"), BorderLayout.EAST);
        add(footer, BorderLayout.SOUTH);

        addButton.addActionListener(e -> addToCart());
        removeButton.addActionListener(e -> removeSelected());
        clearButton.addActionListener(e -> clearOrder());
        placeButton.addActionListener(e -> placeOrder());
    }

    private void updatePriceLabel(JLabel label) {
        int index = itemBox.getSelectedIndex();
        if (index >= 0) label.setText(String.format("Price: Rs. %.2f", prices[index]));
    }

    private void styleButton(JButton button, Color color) {
        button.setBackground(color);
        button.setForeground(Color.WHITE);
        button.setFocusPainted(false);
        button.setFont(new Font("SansSerif", Font.BOLD, 12));
        button.setBorder(BorderFactory.createEmptyBorder(10, 6, 10, 6));
    }

    private void addToCart() {
        int index = itemBox.getSelectedIndex();
        if (index < 0) return;
        String item = items[index];
        int quantity = (Integer) quantitySpinner.getValue();
        for (int row = 0; row < cartModel.getRowCount(); row++) {
            if (cartModel.getValueAt(row, 0).toString().equals(item)) {
                int newQuantity = Integer.parseInt(cartModel.getValueAt(row, 2).toString()) + quantity;
                cartModel.setValueAt(newQuantity, row, 2);
                cartModel.setValueAt(String.format("%.2f", prices[index] * newQuantity), row, 3);
                updateTotal();
                statusLabel.setText(item + " quantity updated in cart.");
                return;
            }
        }
        cartModel.addRow(new Object[]{item, String.format("%.2f", prices[index]), quantity, String.format("%.2f", prices[index] * quantity)});
        updateTotal();
        statusLabel.setText(item + " added to cart.");
    }

    private void removeSelected() {
        int row = cartTable.getSelectedRow();
        if (row < 0) { showMessage("Select an item in the cart to remove."); return; }
        cartModel.removeRow(cartTable.convertRowIndexToModel(row));
        updateTotal();
        statusLabel.setText("Selected item removed.");
    }

    private void clearOrder() {
        if (cartModel.getRowCount() == 0) { statusLabel.setText("Cart is already empty."); return; }
        if (JOptionPane.showConfirmDialog(this, "Clear all items from this order?", "Confirm Clear", JOptionPane.YES_NO_OPTION) == JOptionPane.YES_OPTION) {
            cartModel.setRowCount(0);
            totalLabel.setText("Total: Rs. 0.00");
            billArea.setText(" CANTEEN BILL\nAdd items to begin.");
            statusLabel.setText("Order cleared.");
        }
    }

    private double calculateTotal() {
        double total = 0;
        for (int row = 0; row < cartModel.getRowCount(); row++) total += Double.parseDouble(cartModel.getValueAt(row, 3).toString());
        return total;
    }

    private void updateTotal() {
        totalLabel.setText(String.format("Total: Rs. %.2f", calculateTotal()));
        billArea.setText(cartModel.getRowCount() == 0 ? " CANTEEN BILL\nAdd items to begin." : buildBill("PREVIEW"));
    }

    private String buildBill(String orderType) {
        StringBuilder bill = new StringBuilder();
        bill.append(" CAMPUS CANTEEN\n");
        bill.append("--------------------------------\nOrder: ").append(orderType).append("\n");
        bill.append(LocalDateTime.now().format(DateTimeFormatter.ofPattern("dd-MM-yyyy HH:mm"))).append("\n");
        bill.append("--------------------------------\n");
        for (int row = 0; row < cartModel.getRowCount(); row++) {
            bill.append(cartModel.getValueAt(row, 0)).append("\n ");
            bill.append(cartModel.getValueAt(row, 2)).append(" x Rs. ").append(cartModel.getValueAt(row, 1));
            bill.append(" = Rs. ").append(cartModel.getValueAt(row, 3)).append("\n");
        }
        bill.append("--------------------------------\n");
        bill.append(String.format("TOTAL: Rs. %.2f\n", calculateTotal()));
        bill.append("--------------------------------\n Thank you! Visit again.\n");
        return bill.toString();
    }

    private void placeOrder() {
        if (cartModel.getRowCount() == 0) { showMessage("Please add at least one food item before placing the order."); return; }
        String bill = buildBill("PLACED");
        try (BufferedWriter writer = new BufferedWriter(new OutputStreamWriter(new FileOutputStream(ORDER_FILE, true), StandardCharsets.UTF_8))) {
            String timestamp = LocalDateTime.now().format(DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss"));
            for (int row = 0; row < cartModel.getRowCount(); row++) {
                writer.write(timestamp + "," + cartModel.getValueAt(row, 0) + "," + cartModel.getValueAt(row, 1) + "," + cartModel.getValueAt(row, 2) + "," + cartModel.getValueAt(row, 3));
                writer.newLine();
            }
            writer.write(timestamp + ",TOTAL,,," + String.format("%.2f", calculateTotal()));
            writer.newLine();
            billArea.setText(bill);
            JOptionPane.showMessageDialog(this, bill, "Order Placed Successfully", JOptionPane.INFORMATION_MESSAGE);
            statusLabel.setText("Order saved to " + ORDER_FILE + ".");
            cartModel.setRowCount(0);
            totalLabel.setText("Total: Rs. 0.00");
        } catch (IOException ex) {
            showMessage("Could not save order: " + ex.getMessage());
        }
    }

    private void showMessage(String message) {
        JOptionPane.showMessageDialog(this, message, "Canteen Order", JOptionPane.INFORMATION_MESSAGE);
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> new CanteenOrderManagementSystem().setVisible(true));
    }
}
